  "paths": {
    "/parcela": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "tags": [
          "Parcela"
        ],
        "summary": "Vraća podatke o parcelama u zavisnosti od unetih parametara.",
        "description": "Rezultat se filtrira na osnovu parametra koji moguj biti  naziv katastarske opštine kao i broj same parcele.",
        "parameters": [
          {
            "name": "opstina",
            "in": "query",
            "description": "Opština u kojoj se parcele nalaze",
            "required": false,
            "schema": {
              "type": "string",
              "example": "kladovo"
            }
          },
          {
            "name": "kat_opstina",
            "in": "query",
            "description": "Katastarska opština u kojoj se parcele nalaze",
            "required": false,
            "schema": {
              "type": "string",
              "example": "kladovo"
            }
          },
          {
            "name": "parcela",
            "in": "query",
            "description": "Broj katastarske parcele",
            "required": false,
            "schema": {
              "type": "string",
              "example": ""
            }
          },

          {
            "name": "geom",
            "in": "query",
            "description": "Opcija za prikaz dodatnog polja geometrije u GeoJSON formatu. Za dodavanje željenog polja potrebno je uneti - true.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "polja",
            "in": "query",
            "description": "Parametar za definisanje željenih polja (atributa). U slučaju da želite sva polja potrebno je uneti  -  '*'. Za manuelno definisanje atributa, unose se redom nazivi atributa odvojeni zarezom. ",
            "required": false,
            "schema": {
              "type": "string",
              "example": "*"
            }
          },
          {
            "name": "cir",
            "in": "query",
            "description": "Ukoliko Želite da se pretraga izvršava u ćirilici neophodno je da kod ovog parametra unesete - true.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
		  {
            "name": "page",
            "in": "query",
            "description": "Broj strane. Za prvi set podataka uneti vrednost 0, za drugi vrednost 1, za treći vrednost 2...",
            "required": false,
            "schema": {
              "type": "integer",
              "example": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Uspešno izvršena operacija",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/parcela"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Parcela nije pronađena"
          }
        }
      }
    },
